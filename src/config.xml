<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://arn0.tv/launcher" version="0.6.17" viewmodes="maximized">
    <!-- package must be exactly 10 alphanumeric characters -->
    <!-- Keep this ID stable for installed preferences and the TV-local Home service. -->
    <tizen:application id="Arn0Lnchr0.Launcher" package="Arn0Lnchr0" required_version="4.0"/>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <name>Arn0 NU7093</name>

    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>

    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/application.info"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
    <!-- Open-Meteo request for the screen saver (js/config.js → weather) and the development log -->
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <access origin="*" subdomains="true"/>

    <feature name="http://tizen.org/feature/web.service"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.read"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.write"/>
    <!-- Requests service startup after reboot; a Partner certificate is required. -->
    <tizen:service id="Arn0Lnchr0.HomeWatch" auto-restart="false" on-boot="true">
        <tizen:content src="services/home-return-service.js"/>
        <tizen:name>Arn0 Home Return Service</tizen:name>
        <tizen:description>TV-local Home and SOURCE return for the tested NU7093 build.</tizen:description>
    </tizen:service>

    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable"
                   background-support="disable" encryption="disable"
                   install-location="auto" hwkey-event="enable"/>
</widget>
